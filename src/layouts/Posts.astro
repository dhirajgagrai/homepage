---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"posts">["data"];

const { title, description, pubDate, cover } = Astro.props;

const siteUrl = Astro.site?.toString() || "";
const metaImageUrl = siteUrl.endsWith("/")
    ? siteUrl.slice(0, -1).concat(cover.src)
    : siteUrl.concat(cover.src);
---

<html lang="en">
    <head>
        {cover && <meta property="og:image" content={metaImageUrl} />}
        <BaseHead title={title} description={description} />
        <style>
            hr {
                border-top: 1px solid #ddd;
                margin: 1rem 0;
            }
        </style>
        <style is:global>
            .posts-content h2 {
                margin: 1rem 0;
                font-weight: 600;
                color: #d60000;
            }
            .posts-content p {
                margin: 1rem 0;
            }
            .posts-content ol {
                margin: 1rem 0;
            }
        </style>
    </head>

    <body>
        <Header />
        <main>
            <article>
                {cover && <Image src={cover} alt="" />}
                <h1 class="title">{title}</h1>
                <FormattedDate date={pubDate} />
                <hr />
                <div class="posts-content">
                    <slot />
                </div>
            </article>
        </main>
        <Footer />
    </body>
</html>
